generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Product {
  id        String   @id @default(cuid())
  brand     String
  model     String
  code      String   @unique
  mAh       Int
  voltage   String
  dimension String
  type      String   @default("Li-ion")
  warranty  String   @default("12 bulan")
  origin    String   @default("Original Sumo")
  price     Int
  stock     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Admin {
  id       String @id @default(cuid())
  email    String @unique
  password String
}
